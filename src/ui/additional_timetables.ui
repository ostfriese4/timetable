<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="AdditionalTimetablesPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="AdwNavigationView" id="view">
        <child>
          <object class="AdwNavigationPage">
            <child>
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="title-widget">
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">All timetables</property>
                        <property name="halign">GTK_ALIGN_CENTER</property>
                      </object>
                    </property>
                    <child type="start">
                      <object class="GtkToggleButton" id="show_sidebar_button">
                        <property name="icon-name">adw-sidebar-symbolic</property>
                        <property name="visible">False</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkButton" id="create_timetable_button">
                        <property name="icon-name">list-add-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Create custom timetable</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="OfflineBanner" id="offline"/>
                    </child>
                    <child>
                      <object class="AdwPreferencesPage" id="container"/>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwNavigationPage" id="timetable_page"/>
        </child>
      </object>
    </child>
  </template>
  <object class="AdwDialog" id="edit_timetable_dialog">
    <property name="title" translatable="yes">Edit timetable</property>
    <property name="content-width">350</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwEntryRow" id="recipe_name">
                    <property name="title" translatable="yes">Name</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="recipe_steps">
                <property name="separate-rows">true</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwButtonRow" id="recipe_save">
                    <property name="title" translatable="yes">Save</property>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
