<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="HomeworkEditWindow" parent="AdwDialog">
    <property name="title" translatable="yes">Create homework</property>
    <property name="content-width">400</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwPreferencesRow">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Date</property>
                            <property name="halign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCalendar" id="date"/>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="task">
                    <property name="title" translatable="yes">Task</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="subject">
                    <property name="title" translatable="yes">Subject</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="completed">
                    <property name="title" translatable="yes">Completed</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwButtonRow" id="save">
                    <property name="title" translatable="yes">Save</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
