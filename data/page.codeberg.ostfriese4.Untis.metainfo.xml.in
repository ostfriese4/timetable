<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>page.codeberg.ostfriese4.Untis</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Timetable</name>
  <summary>A client for webuntis</summary>
  <description>
    <p>Timetable is an unofficial client for WebUntis, which focusses on the featured used by students.</p>
  </description>

  <developer id="tld.vendor">
    <name>Jonas Harer</name>
  </developer>

  <url type="homepage">https://codeberg.org/ostfriese4/untis</url>
  <url type="vcs-browser">https://codeberg.org/ostfriese4/untis</url>
  <url type="bugtracker">https://codeberg.org/ostfriese4/untis/issues</url>

  <translation type="gettext">untis</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">page.codeberg.ostfriese4.Untis.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#eedd00</color>
    <color type="primary" scheme_preference="dark">#ee9900</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://codeberg.org/ostfriese4/untis/raw/branch/main/screenshots/timetable.png</image>
      <caption>The timetable</caption>
    </screenshot>
    <screenshot>
      <image>https://codeberg.org/ostfriese4/untis/raw/branch/main/screenshots/information.png</image>
      <caption>Dialog showing information about a lesson</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0" date="2026-03-13">
      <description translate="no">
        <p>First release</p>
      </description>
    </release>
  </releases>

</component>
